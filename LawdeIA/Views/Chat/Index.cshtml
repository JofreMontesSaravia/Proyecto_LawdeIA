@{
    ViewData["Title"] = "LawdeIA - Chat";
    Layout = null;
}
<!DOCTYPE html>
<html lang="es" data-theme="dark">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>
    <!-- Se mantiene Font Awesome para otros íconos como el de enviar -->
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <link href="~/css/Chat.css" rel="stylesheet">
</head>
<body>
    <!-- Definición del SVG del símbolo de Grok (círculo con barra) -->
    <svg style="display:none;">
        <symbol id="grok-symbol" viewBox="0 0 512 512">
            <path d="M256 0C114.6 0 0 114.6 0 256s114.6 256 256 256s256-114.6 256-256S397.4 0 256 0zM256 464c-114.9 0-208-93.1-208-208S141.1 48 256 48s208 93.1 208 208S370.9 464 256 464zM256 128c-70.7 0-128 57.3-128 128s57.3 128 128 128s128-57.3 128-128S326.7 128 256 128zM256 336c-44.2 0-80-35.8-80-80s35.8-80 80-80s80 35.8 80 80S300.2 336 256 336zM256 288c17.7 0 32-14.3 32-32s-14.3-32-32-32s-32 14.3-32 32s14.3 32 32 32z" />
        </symbol>
    </svg>

    <div class="chat-app">
        <!-- SIDEBAR -->
        <div class="sidebar">
            <div class="sidebar-header">
                <!-- Uso del SVG para el logo -->
                <div class="logo">
                    <svg class="grok-symbol"><use href="#grok-symbol" /></svg>
                    LawdeIA
                </div>
            </div>
            <button id="new-chat-btn" class="new-chat"><i class="fas fa-plus"></i> Nueva consulta</button>
            <div id="conversations-sidebar" style="flex:1;overflow-y:auto;padding:0 1rem;">
                <!-- Aquí irían las conversaciones -->
            </div>
            <!-- USER INFO AREA (Refactorizado) -->
            <div class="user-info-area">
                <div class="user-profile">
                    <div class="user-avatar" id="user-avatar">U</div>
                    <div class="user-details">
                        <div id="user-name">Usuario</div>
                        <small id="user-email">usuario@ejemplo.com</small>
                    </div>
                </div>
                <form asp-controller="Auth" asp-action="Logout" method="post">
                    <button type="submit" class="logout-button">
                        <i class="fas fa-sign-out-alt"></i> Cerrar sesión
                    </button>
                </form>
            </div>
        </div>

        <!-- MAIN -->
        <div class="main">
            <div id="messages" class="messages">
                <div class="empty-state">
                    <div class="logo-container">
                        <div class="grok-logo">
                            <!-- Uso del SVG para el logo grande -->
                            <svg class="grok-symbol"><use href="#grok-symbol" /></svg>
                        </div>
                    </div>
                    <!-- Se elimina el logo repetido aquí -->
                    <h1>LawdeIA</h1>
                    <p>Soy LawdeIA, tu asistente legal basado en IA. Pregúntame cualquier cosa sobre leyes, jurisprudencia o normativas.</p>
                </div>
            </div>

            <div class="input-area">
                <div class="input-wrapper">
                    <textarea id="message-input" placeholder="Escribe tu consulta..." rows="1"></textarea>
                    <button id="send-btn" class="send-button">
                        <!-- Se mantiene el ícono de Font Awesome para enviar -->
                        <i class="fas fa-paper-plane"></i>
                    </button>
                </div>
                <div style="text-align:center;margin-top:0.75rem;font-size:0.8rem;color:var(--text-muted);">
                    La información es generada por IA. Verifica siempre las fuentes.
                </div>
            </div>
        </div>
    </div>

    <script>
        // Script para auto-ajustar la altura del textarea
        const textarea = document.getElementById('message-input');
        textarea.addEventListener('input', function () {
            this.style.height = 'auto';
            this.style.height = (this.scrollHeight) + 'px';
        });
    </script>
    <!-- Se mantiene el script original del usuario -->
    <script src="~/js/chatcode.js" asp-append-version="true"></script>
</body>
</html>
